# ==========================================
# Supabase Configuration
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==========================================
# Google Gemini (스캔 PDF OCR 전용, 임베딩은 로컬 384차원 모델 사용)
# ==========================================
GEMINI_API_KEY=your-google-ai-studio-gemini-api-key
GEMINI_OCR_MODEL=gemini-2.0-flash

# ==========================================
# Groq LLM Configuration
# ==========================================
GROQ_API_KEY=your-groq-console-api-key
GROQ_CHAT_MODEL=qwen/qwen3.8-27b

# ==========================================
# Admin Authentication
# ==========================================
ADMIN_API_TOKEN=your-secret-admin-token

# ==========================================
# RAG Settings
# ==========================================
RAG_SIMILARITY_THRESHOLD=0.80
